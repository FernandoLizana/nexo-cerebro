<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!--
      Cleartext ONLY for explicit lab domains (emulator gateway + loopback).
      Physical phones: configure the hub LAN IP in the UI and use HTTPS/TLS,
      or extend this allowlist carefully for a known lab IP. Arbitrary LAN
      cleartext is intentionally not opened by default.
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">localhost</domain>
    </domain-config>
</network-security-config>
